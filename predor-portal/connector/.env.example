# Hova küldje az adatot (a mi portálunk)
PORTAL_URL=https://portal.example.com
INGEST_TOKEN=ide-jon-a-tenant-token
INGEST_SECRET=ide-jon-az-alairo-kulcs

# Adatforrás: predor-api vagy csv
SOURCE=predor-api

# --- predor-api mód ---
# A Predor szerver címe a belső hálózaton és az operátorhoz tartozó API kulcs
PREDOR_API_URL=http://10.0.5.12:8888
PREDOR_API_KEY=ide-jon-a-predor-api-kulcs
# Az útvonal a Predor API leírás alapján pontosítandó. {cursor} az utolsó feldolgozott esemény azonosítója.
PREDOR_EVENTS_PATH=/api/v1/events?fromId={cursor}&limit=1000
POLL_SECONDS=60

# --- csv mód ---
# Ide menti a Predor az időzített exportot (megosztott mappa a /data/inbox alá csatolva)
CSV_DELIMITER=;

# Olvasónév -> portál ajtóazonosító (JSON)
DOOR_MAP={"Főbejárat":"bp-fo","Szerverszoba":"bp-szerver"}
